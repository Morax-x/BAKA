<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="740"
             x:Class="BugalterProject.pagini.components.RegisterPage">
    <Grid Margin="14,14,14,0">
        <Border Background="#2A2A2A"
                BorderBrush="#505050"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Background="#333333" BorderBrush="#505050" BorderThickness="0,0,0,1" Padding="18,10">
                    <TextBlock HorizontalAlignment="Center"
                               Text="Bani Asistent si Kontrol Activetati ( BAKA )"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Spacing="10">
                    <Button x:Name="RegisterTabButton"
                            Content="Inregistrare"
                            Padding="20,10"
                            Background="#4A4A4A"
                            Foreground="White"
                            Click="ShowRegisterMode"/>
                    <Button x:Name="LoginTabButton"
                            Content="Autentificare"
                            Padding="20,10"
                            Background="#3A3A3A"
                            Foreground="White"
                            Click="ShowLoginMode"/>
                </StackPanel>

                <Grid Grid.Row="2" Margin="100,20,100,30">
                    <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="24">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ModeTitle"
                                           Text="Inregistrarea"
                                           HorizontalAlignment="Center"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                                <TextBlock x:Name="ModeDescription"
                                           Text="Creeaza un cont nou pentru a accesa aplicatia."
                                           HorizontalAlignment="Center"
                                           Foreground="#CFCFCF"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="18" Margin="0,20,0,0">
                                <StackPanel x:Name="RegisterPanel" Spacing="16">
                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu numele" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="FirstNameBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu prenumele" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="LastNameBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu email" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="EmailRegisterBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu parola" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="PasswordRegisterBox" Grid.Column="1" Padding="12" Background="#3A3A3A" Foreground="White" PasswordChar="*"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.2*,.6*,.7*,Auto" ColumnSpacing="14">
                                        <TextBlock Text="Confirma captcha" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <Border Grid.Column="1" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <TextBlock x:Name="RegisterCaptchaText"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBox x:Name="CaptchaRegisterBox" Grid.Column="2" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                                        <Button Grid.Column="3"
                                                Content="Refresh"
                                                Padding="14,10"
                                                Background="#3A3A3A"
                                                Foreground="White"
                                                Click="RefreshCaptcha"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.3*,Auto" ColumnSpacing="20" Margin="0,10,0,0">
                                        <StackPanel Spacing="10">
                                            <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                <TextBlock Text="Sunteti de acord cu Politica companiei" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="Politica companiei" Foreground="#7DB4FF" TextDecorations="Underline" Margin="12,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <CheckBox x:Name="PolicyCheck"/>
                                            <TextBlock Text="Confirmare" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="LoginPanel" Spacing="16" IsVisible="False">
                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu email" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="EmailLoginBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                        <TextBlock Text="Introdu parola" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                        <TextBox x:Name="PasswordLoginBox" Grid.Column="1" Padding="12" Background="#3A3A3A" Foreground="White" PasswordChar="*"/>
                                    </Grid>

                                    <TextBlock Text="Pentru autentificare este necesara doar confirmarea datelor existente."
                                               Foreground="#CFCFCF"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock x:Name="StatusText"
                                           Text="Completeaza campurile si apasa Continue."
                                           Foreground="#CFCFCF"
                                           TextWrapping="Wrap"/>

                                <Button x:Name="ActionButton"
                                        Content="Continue"
                                        HorizontalAlignment="Right"
                                        Padding="22,10"
                                        Background="#3A3A3A"
                                        Foreground="White"
                                        Click="SubmitAction"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
