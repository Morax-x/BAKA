<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="740"
             x:Class="BugalterProject.pagini.components.RegisterPage">
    <Grid Margin="14,14,14,0">
        <Border Background="#2A2A2A"
                BorderBrush="#505050"
                BorderThickness="1"
                CornerRadius="8">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#333333" BorderBrush="#505050" BorderThickness="0,0,0,1" Padding="18,10">
                    <TextBlock HorizontalAlignment="Center"
                               Text="Bani Asistent si Kontrol Activetati ( BAKA )"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                </Border>

                <StackPanel Grid.Row="1" Margin="100,30" Spacing="20">
                    <TextBlock Text="Inregistrarea"
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                <TextBlock Text="Introdu numele" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                <TextBox x:Name="FirstNameBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                            </Grid>

                            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                <TextBlock Text="Introdu prenumele" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                <TextBox x:Name="LastNameBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                            </Grid>

                            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                <TextBlock Text="Introdu email" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                <TextBox x:Name="EmailBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                            </Grid>

                            <Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="14">
                                <TextBlock Text="Introdu parola" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                <TextBox x:Name="PasswordBox" Grid.Column="1" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                            </Grid>

                            <Grid ColumnDefinitions="1.2*,.6*,.7*" ColumnSpacing="14">
                                <TextBlock Text="Confirma captcha" VerticalAlignment="Center" FontSize="17" Foreground="White"/>
                                <Border Grid.Column="1" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <TextBlock Text="Captcha" HorizontalAlignment="Center" Foreground="White"/>
                                </Border>
                                <TextBox x:Name="CaptchaBox" Grid.Column="2" PlaceholderText="Input" Padding="12" Background="#3A3A3A" Foreground="White"/>
                            </Grid>

                            <Grid ColumnDefinitions="1.3*,Auto" ColumnSpacing="20" Margin="0,10,0,0">
                                <StackPanel Spacing="10">
                                    <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <TextBlock Text="Sunteti de acord cu Politica companiei" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Politica companiei" Foreground="#7DB4FF" TextDecorations="Underline" Margin="12,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <CheckBox x:Name="PolicyCheck"/>
                                    <TextBlock Text="Confirmare" Foreground="White"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Text="Completeaza campurile si apasa Continue."
                                       Foreground="#CFCFCF"
                                       TextWrapping="Wrap"/>

                            <Button Content="Continue"
                                    HorizontalAlignment="Right"
                                    Padding="22,10"
                                    Background="#3A3A3A"
                                    Foreground="White"
                                    Click="ContinueToApp"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
