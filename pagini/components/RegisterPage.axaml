<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="780"
             x:Class="BugalterProject.pagini.components.RegisterPage">
    <Grid Margin="14,14,14,0">
        <Border CornerRadius="26" BorderBrush="#4B5568" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B2230" Offset="0"/>
                    <GradientStop Color="#141A24" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid RowDefinitions="Auto,Auto,*">
                <Border Background="#171D28" Padding="22,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Width="54" Height="54" CornerRadius="16" Background="#D9A441">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="B" FontSize="30" FontWeight="Bold" Foreground="#1E2330"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="BAKA" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="Bani Asistent si Kontrol Activetati" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Center" Background="#242D3C" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="999" Padding="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="RegisterTabButton"
                                Content="Inregistrare"
                                Background="#C4943F"
                                Foreground="#1E2330"
                                Click="ShowRegisterMode"/>
                        <Button x:Name="LoginTabButton"
                                Content="Autentificare"
                                Background="#324055"
                                Click="ShowLoginMode"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="92,26,92,32">
                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="24" Padding="28">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ModeTitle"
                                           Text="Inregistrarea"
                                           HorizontalAlignment="Center"
                                           FontSize="28"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="ModeDescription"
                                           Text="Creeaza un cont nou pentru a accesa aplicatia."
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Spacing="18" Margin="0,22,0,0">
                                <StackPanel x:Name="RegisterPanel" Spacing="16">
                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu numele" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="FirstNameBox" Grid.Column="1" PlaceholderText="Input"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu prenumele" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="LastNameBox" Grid.Column="1" PlaceholderText="Input"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu email" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="EmailRegisterBox" Grid.Column="1" PlaceholderText="Input"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu parola" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="PasswordRegisterBox" Grid.Column="1" PasswordChar="*"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.05*,.65*,.75*,Auto" ColumnSpacing="14">
                                        <TextBlock Text="Confirma captcha" VerticalAlignment="Center" FontSize="17"/>
                                        <Border Grid.Column="1" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="12,10">
                                            <TextBlock x:Name="RegisterCaptchaText"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="Bold"/>
                                        </Border>
                                        <TextBox x:Name="CaptchaRegisterBox" Grid.Column="2" PlaceholderText="Input"/>
                                        <Button Grid.Column="3"
                                                Content="Refresh"
                                                Background="#324055"
                                                Click="RefreshCaptcha"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.3*,Auto" ColumnSpacing="22" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                                <TextBlock Text="Sunteti de acord cu Politica companiei"/>
                                            </Border>
                                            <TextBlock Text="Politica companiei" Foreground="#8FB9FF" TextDecorations="Underline" Margin="12,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <CheckBox x:Name="PolicyCheck"/>
                                            <TextBlock Text="Confirmare"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="LoginPanel" Spacing="16" IsVisible="False">
                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu email" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="EmailLoginBox" Grid.Column="1" PlaceholderText="Input"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="1.2*,1*" ColumnSpacing="16">
                                        <TextBlock Text="Introdu parola" VerticalAlignment="Center" FontSize="17"/>
                                        <TextBox x:Name="PasswordLoginBox" Grid.Column="1" PasswordChar="*"/>
                                    </Grid>

                                    <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="14">
                                        <TextBlock Text="Pentru autentificare este necesara doar confirmarea datelor existente."
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="14" Padding="14">
                                    <TextBlock x:Name="StatusText"
                                               Text="Completeaza campurile si apasa Continue."
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="ActionButton"
                                        Content="Continue"
                                        HorizontalAlignment="Right"
                                        Background="#C4943F"
                                        Foreground="#1E2330"
                                        Click="SubmitAction"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
