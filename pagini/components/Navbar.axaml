<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="88"
             x:Class="BugalterProject.pagini.components.Navbar">

    <Border Margin="14,14,14,10"
            Padding="16,12"
            Background="#2A2A2A"
            BorderBrush="#505050"
            BorderThickness="1"
            CornerRadius="8">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="BAKA" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Bani Asistent si Kontrol Activetati" FontSize="12" Foreground="#CFCFCF"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                <Button Content="Main" Padding="18,10" Background="#3A3A3A" Foreground="White" Click="OpenDashboard"/>
                <Button Content="Datorii" Padding="18,10" Background="#3A3A3A" Foreground="White" Click="OpenDebts"/>
                <Button Content="Servicii com." Padding="18,10" Background="#3A3A3A" Foreground="White" Click="OpenUtilities"/>
                <Button Content="Istoricul" Padding="18,10" Background="#3A3A3A" Foreground="White" Click="OpenHistory"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Content="Cont"
                    Padding="18,10"
                    Background="#3A3A3A"
                    Foreground="White"
                    VerticalAlignment="Center"
                    Click="OpenAccount"/>
        </Grid>
    </Border>
</UserControl>
