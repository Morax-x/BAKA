<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="640"
             x:Class="BugalterProject.pagini.Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Panoul principal" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Pagina principala contine bugetul curent, datoriile totale si cheltuielile lunare."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Buget curent" FontSize="15" Foreground="White"/>
                        <TextBlock x:Name="BudgetValueText" Text="0.00 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Valoarea este introdusa manual si salvata pentru utilizatorul curent." Foreground="#CFCFCF" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="BudgetInputBox"
                                     Width="150"
                                     Background="#3A3A3A"
                                     Foreground="White"
                                     BorderBrush="#505050"
                                     PlaceholderText="Ex: 15000"/>
                            <Button Content="Salveaza" Click="SaveBudget" Padding="14,10" Background="#3A3A3A" Foreground="White"/>
                        </StackPanel>
                        <TextBlock x:Name="BudgetStatusText" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Datorii totale" FontSize="15" Foreground="White"/>
                        <TextBlock x:Name="DebtsValueText" Text="0.00 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Sunt calculate doar din datoriile introduse in aplicatie." Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli pe luna" FontSize="15" Foreground="White"/>
                        <TextBlock x:Name="MonthlyExpensesText" Text="0.00 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Sunt calculate automat pentru luna curenta din cheltuielile introduse." Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.25*,1*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Datorii apropiate" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border x:Name="ObligationCard1" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle1" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle1" Text="Introdu obligatii pentru a le vedea aici" Foreground="#CFCFCF"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount1" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="ObligationDate1" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ObligationCard2" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle2" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle2" Text="Introdu obligatii pentru a le vedea aici" Foreground="#CFCFCF"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount2" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock x:Name="ObligationDate2" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Categorii de cheltuieli" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border x:Name="CategoryCard1" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="CategoryName1" Text="Nu exista date" Foreground="White"/>
                                <TextBlock x:Name="CategoryAmount1" Grid.Column="1" Text="0.00 MDL" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CategoryCard2" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="CategoryName2" Text="Nu exista date" Foreground="White"/>
                                <TextBlock x:Name="CategoryAmount2" Grid.Column="1" Text="0.00 MDL" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="CategoryCard3" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock x:Name="CategoryName3" Text="Nu exista date" Foreground="White"/>
                                <TextBlock x:Name="CategoryAmount3" Grid.Column="1" Text="0.00 MDL" Foreground="White"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
