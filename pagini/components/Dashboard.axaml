<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="640"
             x:Class="BugalterProject.pagini.Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Panoul principal" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Pagina principala contine bugetul curent, datoriile totale si cheltuielile lunare."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Buget curent" FontSize="15" Foreground="White"/>
                        <TextBlock Text="15 000 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Valoare orientativa pentru luna aceasta" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Datorii totale" FontSize="15" Foreground="White"/>
                        <TextBlock Text="4 980 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Credite, servicii comunale si datorii personale" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli pe luna" FontSize="15" Foreground="White"/>
                        <TextBlock Text="7 420 MDL" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Comparatia cu luna trecuta va fi afisata in istoric" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.25*,1*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Datorii apropiate" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Electricitate" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Servicii comunale" Foreground="#CFCFCF"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="820 MDL" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="18 mai" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="Credit telefon" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Plata bancara" Foreground="#CFCFCF"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="1 350 MDL" VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Grid.Column="2" Text="24 mai" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Categorii de cheltuieli" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Mancare" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="2 100 MDL" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Transport" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="840 MDL" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Abonamente" Foreground="White"/>
                                <TextBlock Grid.Column="1" Text="320 MDL" Foreground="White"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
