<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.Dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="24"
                    BorderBrush="#495569"
                    BorderThickness="1"
                    Padding="26">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#273142" Offset="0"/>
                        <GradientStop Color="#1C2431" Offset="0.55"/>
                        <GradientStop Color="#151B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="1.2*,0.8*" ColumnSpacing="20">
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left"
                                Padding="10,4"
                                CornerRadius="999"
                                Background="#40331E">
                            <TextBlock Text="Panoul principal"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Control clar pentru banii tai, fara cifre inventate."
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Aici vezi imediat ce trebuie platit, ce trebuie recuperat si cum s-au distribuit cheltuielile lunare."
                                   FontSize="15"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#141A24"
                            BorderBrush="#3D485A"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="18">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Buget curent"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock x:Name="BudgetValueText"
                                       Text="0.00 MDL"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="Valoarea este salvata manual pentru utilizatorul curent."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="BudgetInputBox"
                                         Width="170"
                                         PlaceholderText="Ex: 15000"/>
                                <Button Content="Salveaza"
                                        Click="SaveBudget"
                                        Background="#C4943F"
                                        Foreground="#1E2330"/>
                            </StackPanel>
                            <TextBlock x:Name="BudgetStatusText"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="De achitat" FontSize="15" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PayableDebtsValueText" Text="0.00 MDL" FontSize="30" FontWeight="Bold" Foreground="#F0C36A"/>
                        <TextBlock Text="Include datoriile active si sumele pe care trebuie sa le achiti in perioada urmatoare."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="De recuperat" FontSize="15" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="ReceivableDebtsValueText" Text="0.00 MDL" FontSize="30" FontWeight="Bold" Foreground="#88C59C"/>
                        <TextBlock Text="Aici apare totalul sumelor pe care alte persoane trebuie sa ti le intoarca."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Cheltuieli pe luna" FontSize="15" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="MonthlyExpensesText" Text="0.00 MDL" FontSize="30" FontWeight="Bold" Foreground="#8FB9FF"/>
                        <TextBlock Text="Sunt calculate automat din cheltuieli si servicii comunale pentru luna curenta."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="16">
                <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Obligatii si recuperari apropiate"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Cele mai apropiate datorii, recuperari si servicii care cer atentie."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border x:Name="ObligationCard1" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle1" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle1" Text="Introdu obligatii pentru a le vedea aici" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount1" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ObligationDate1" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ObligationCard2" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle2" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle2" Text="Introdu obligatii pentru a le vedea aici" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount2" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ObligationDate2" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ObligationCard3" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle3" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle3" Text="Introdu obligatii pentru a le vedea aici" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount3" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ObligationDate3" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>

                        <Border x:Name="ObligationCard4" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock x:Name="ObligationTitle4" Text="Nu exista date" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="ObligationSubtitle4" Text="Introdu obligatii pentru a le vedea aici" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock x:Name="ObligationAmount4" Grid.Column="1" Text="0.00 MDL" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock x:Name="ObligationDate4" Grid.Column="2" Text="-" VerticalAlignment="Center" Foreground="White"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Categorii de cheltuieli"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Suma totala cheltuita pe fiecare categorie in luna curenta, inclusiv serviciile comunale."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <TextBlock x:Name="CategoriesSummaryText"
                                       Text="Nu exista date"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
