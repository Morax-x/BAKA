<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.AccountPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#495569" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#263142" Offset="0"/>
                        <GradientStop Color="#1B2330" Offset="0.6"/>
                        <GradientStop Color="#141B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="8">
                        <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#40331E">
                            <TextBlock Text="Cont" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Contul utilizatorului" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Gestionare simpla pentru datele curente ale contului si pentru actiunile importante."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                        <Button Content="Dezlogare" Click="Logout" Background="#324055"/>
                        <Button Content="Stergere cont" Click="DeleteAccount" Background="{StaticResource DangerBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.15*,0.85*" ColumnSpacing="16">
                <StackPanel Spacing="16">
                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Datele principale" FontSize="24" FontWeight="Bold"/>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <TextBlock Text="Numele" FontSize="18"/>
                                </Border>
                                <Button Grid.Column="1" Content="Modifica" Background="#324055"/>

                                <Border Grid.Row="1" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <TextBlock Text="Email" FontSize="18"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="1" Content="Modifica" Background="#324055"/>

                                <Border Grid.Row="2" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="12" Padding="14">
                                    <TextBlock Text="Schimba parola" FontSize="18"/>
                                </Border>
                                <Button Grid.Row="2" Grid.Column="1" Content="Modifica" Background="#324055"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Informatii cont" FontSize="24" FontWeight="Bold"/>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock x:Name="UserNameText" Text="Utilizator curent" FontSize="18"/>
                                    <TextBlock x:Name="UserEmailText" Text="Email" FontSize="18"/>
                                    <TextBlock x:Name="UserRoleText" Text="Rol: user" FontSize="18"/>
                                    <TextBlock Text="Data logarii in sistem: 2026/05/07" FontSize="18"/>
                                    <TextBlock Text="Sunteti cu noi de acum 2 ore si 18 minute." FontSize="18" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Preferinte" FontSize="24" FontWeight="Bold"/>

                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <TextBlock Text="Schimba tema" FontSize="18"/>
                                    <ToggleSwitch Grid.Column="1" OnContent="Alb" OffContent="Negru" IsChecked="True"/>
                                </Grid>
                            </Border>

                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <TextBlock Text="Schimba limba" FontSize="18"/>
                                    <ComboBox Grid.Column="1" Width="180" SelectedIndex="0">
                                        <ComboBoxItem Content="Romana"/>
                                        <ComboBoxItem Content="Russkii"/>
                                        <ComboBoxItem Content="English"/>
                                    </ComboBox>
                                </Grid>
                            </Border>

                            <CheckBox x:Name="DeleteConfirmCheck" Content="Confirm stergerea contului"/>
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
