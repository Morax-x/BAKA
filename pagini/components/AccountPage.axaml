<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="640"
             x:Class="BugalterProject.pagini.components.AccountPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <TextBlock Text="Contul utilizatorului" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                    <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Account" Padding="18,10" Background="#3A3A3A" Foreground="White"/>
                        <Button Content="Dezlogare" Padding="18,10" Background="#3A3A3A" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="1.3*,.9*" ColumnSpacing="14">
                <StackPanel Spacing="14">
                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                            <TextBlock Text="Numele" FontSize="18" Foreground="White"/>
                            <Button Grid.Column="1" Content="Modifica" Padding="18,10" Background="#3A3A3A" Foreground="White"/>

                            <TextBlock Grid.Row="1" Text="Email" FontSize="18" Foreground="White"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="Modifica" Padding="18,10" Background="#3A3A3A" Foreground="White"/>

                            <TextBlock Grid.Row="2" Text="Schimba parola" FontSize="18" Foreground="White"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="Modifica" Padding="18,10" Background="#3A3A3A" Foreground="White"/>
                        </Grid>
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Data logarii in sistem: 2026/05/07" FontSize="18" Foreground="White"/>
                            <TextBlock Text="Sunteti cu noi de acum 2 ore si 18 minute." FontSize="18" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <TextBlock Text="Schimba tema" FontSize="18" Foreground="White"/>
                                <ToggleSwitch Grid.Column="1" OnContent="Alb" OffContent="Negru" IsChecked="True"/>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                <TextBlock Text="Schimba limba" FontSize="18" Foreground="White"/>
                                <ComboBox Grid.Column="1" Width="180" SelectedIndex="0" Background="#3A3A3A" Foreground="White">
                                    <ComboBoxItem Content="Romana"/>
                                    <ComboBoxItem Content="Russkii"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
