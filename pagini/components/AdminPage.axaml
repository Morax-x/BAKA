<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="640"
             x:Class="BugalterProject.pagini.components.AdminPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Panoul administratorului" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text=""
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Gestionare utilizatori" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Aici este afisata lista tuturor utilizatorilor inregistrati in sistem."
                                   Foreground="White"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="UsersCountText"
                                   Text="Utilizatori gasiti: 0"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <ListBox x:Name="UsersList"
                                 Background="#252525"
                                 BorderBrush="#505050"
                                 BorderThickness="1"
                                 Foreground="White"
                                 Height="330">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:AppUser">
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="#3A3A3A"
                                            BorderBrush="#505050"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding FirstName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding LastName}" Foreground="White"/>
                                            <TextBlock Text="{Binding Email}" Foreground="#CFCFCF"/>
                                            <TextBlock Text="{Binding Role}" Foreground="#7DB4FF"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Roluri disponibile" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="user - drepturi standard" Foreground="White"/>
                        <TextBlock Text="admin - drepturi extinse" Foreground="White"/>
                        <TextBlock Text="" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
