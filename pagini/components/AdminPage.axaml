<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.AdminPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#5A4B2C" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3A2E1F" Offset="0"/>
                        <GradientStop Color="#241F27" Offset="0.55"/>
                        <GradientStop Color="#171C25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#5A4624">
                        <TextBlock Text="Administrare" FontWeight="SemiBold" Foreground="#F0C36A"/>
                    </Border>
                    <TextBlock Text="Panoul administratorului" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Vizualizare utilizatori, schimbare de roluri si control rapid asupra structurii sistemului."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="16">
                <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Gestionare utilizatori" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Aici este afisata lista tuturor utilizatorilor inregistrati in sistem."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="UsersCountText"
                                   Text="Utilizatori gasiti: 0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ListBox x:Name="UsersList"
                                 Height="500"
                                 SelectionChanged="UsersList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:AppUser">
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            Background="#283243"
                                            BorderBrush="#3C4960"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding FirstName}" FontWeight="Bold" FontSize="17"/>
                                            <TextBlock Text="{Binding LastName}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Email}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <Border HorizontalAlignment="Left" Background="#3A4962" CornerRadius="999" Padding="10,4">
                                                <TextBlock Text="{Binding Role}" Foreground="#A8C8FF"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Actiuni administrator" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Administratorul poate schimba rolul, sterge utilizatori si urmari statisticile generale ale sistemului."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator selectat" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock x:Name="SelectedUserText"
                                           Text="Niciun utilizator selectat"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Seteaza user" Click="SetUserRole" Margin="0,0,10,10" Background="#324055"/>
                            <Button Content="Seteaza admin" Click="SetAdminRole" Margin="0,0,10,10" Background="#5E4624"/>
                            <Button Content="Sterge utilizator" Click="DeleteSelectedUser" Margin="0,0,10,10" Background="{StaticResource DangerBrush}"/>
                        </WrapPanel>

                        <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="14" Padding="14">
                            <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Statistici generale" FontWeight="Bold" FontSize="18"/>
                                <TextBlock x:Name="AdminStatsText"
                                           Text="Se incarca statisticile..."
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Roluri disponibile" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="user - drepturi standard" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="admin - drepturi extinse" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
