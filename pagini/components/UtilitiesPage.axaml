<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             x:Class="BugalterProject.pagini.components.UtilitiesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Serviciile comunale" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sectiunea permite evidenta platilor pentru apa, lumina, gaz si internet."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1.3*,1*" ColumnSpacing="14">
                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Lista platilor comunale" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="UtilitiesCountText" Text="Plati gasite: 0" FontWeight="Bold" Foreground="White"/>

                        <ListBox x:Name="UtilitiesList"
                                 Background="#252525"
                                 BorderBrush="#505050"
                                 BorderThickness="1"
                                 Foreground="White"
                                 Height="500"
                                 SelectionChanged="UtilitiesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:UtilityItem">
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="#3A3A3A"
                                            BorderBrush="#505050"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding UtilityName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="#CFCFCF"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding UtilityDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#CFCFCF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}" Foreground="#7DB4FF" Margin="12,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Formular plata comunala" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border x:Name="UserPickerBorder" Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="UserCombo" Background="#3A3A3A" Foreground="White" BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Serviciu" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="UtilityNameCombo" Background="#3A3A3A" Foreground="White" BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="AmountBox" Background="#3A3A3A" Foreground="White" BorderBrush="#505050" PlaceholderText="Ex: 432.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Data platii" FontWeight="Bold" Foreground="White"/>
                                <DatePicker x:Name="UtilityDatePicker" Background="#3A3A3A" Foreground="White" BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Adauga" Click="AddUtility" Padding="16,10" Background="#3A3A3A" Foreground="White"/>
                            <Button Content="Actualizeaza" Click="UpdateUtility" Padding="16,10" Background="#3A3A3A" Foreground="White"/>
                            <Button Content="Marcheaza achitata" Click="MarkUtilityPaid" Padding="16,10" Background="#355E3B" Foreground="White"/>
                            <Button Content="Sterge" Click="DeleteUtility" Padding="16,10" Background="#7A2E2E" Foreground="White"/>
                            <Button Content="Goleste" Click="ClearForm" Padding="16,10" Background="#3A3A3A" Foreground="White"/>
                        </StackPanel>

                        <TextBlock x:Name="TotalText" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
