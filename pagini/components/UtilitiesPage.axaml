<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.UtilitiesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#495569" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#243246" Offset="0"/>
                        <GradientStop Color="#1B2330" Offset="0.6"/>
                        <GradientStop Color="#141B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#40331E">
                        <TextBlock Text="Servicii comunale" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Plati pentru apa, lumina, gaz si internet" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Poti lucra manual sau automat dupa contor, iar apoi urmaresti usor platile ramase."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.95*,1.2*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Formular plata comunala" FontSize="24" FontWeight="Bold"/>

                        <Border x:Name="UserPickerBorder" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="UserCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Serviciu" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="UtilityNameCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Mod completare" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="EntryModeCombo" SelectionChanged="EntryModeCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AutomaticCalculationBorder" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Calcul automat dupa contor" FontWeight="Bold" FontSize="17"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <TextBlock Text="Contor precedent" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox x:Name="PreviousReadingBox" PlaceholderText="Ex: 1240" TextChanged="AutoCalculationValueChanged"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Contor curent" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBox x:Name="CurrentReadingBox" PlaceholderText="Ex: 1285" TextChanged="AutoCalculationValueChanged"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Tarif pe unitate" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox x:Name="TariffBox" PlaceholderText="Ex: 15.75" TextChanged="AutoCalculationValueChanged"/>
                                </StackPanel>
                                <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="12" Padding="12">
                                    <TextBlock x:Name="AutoCalculationText"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Text="Introdu valorile contorului pentru a calcula suma."/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="AmountLabelText" Text="Suma" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="AmountBox" PlaceholderText="Ex: 432.00"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PaymentAmountBorder" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma achitata acum" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="PaymentAmountBox" PlaceholderText="Ex: 100.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Data platii" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="UtilityDatePicker"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Salveaza"
                                    Click="SaveUtility"
                                    Margin="0,0,10,10"
                                    Background="#C4943F"
                                    Foreground="#1E2330"/>
                            <Button x:Name="ClearSelectionButton"
                                    Content="Anuleaza selectia"
                                    Click="ClearForm"
                                    Margin="0,0,10,10"
                                    Background="#324055"/>
                            <Button x:Name="ApplyPaymentButton"
                                    Content="Aplica plata"
                                    Click="ApplyUtilityPayment"
                                    Margin="0,0,10,10"
                                    Background="#486B4F"/>
                            <Button Content="Sterge"
                                    Click="DeleteUtility"
                                    Margin="0,0,10,10"
                                    Background="{StaticResource DangerBrush}"/>
                        </WrapPanel>

                        <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="TotalText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Lista platilor comunale" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="UtilitiesCountText" Text="Plati gasite: 0" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="6" Width="230">
                                    <TextBlock Text="Afisare" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox x:Name="UtilityViewCombo" SelectionChanged="UtilityViewCombo_SelectionChanged"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ListBox x:Name="UtilitiesList"
                                 Height="560"
                                 SelectionChanged="UtilitiesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:UtilityItem">
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            Background="#283243"
                                            BorderBrush="#3C4960"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="{Binding UtilityName}" FontWeight="Bold" FontSize="17"/>
                                                <Border Grid.Column="1" Background="#3A4962" CornerRadius="999" Padding="10,4">
                                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}" Foreground="#A8C8FF"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding UtilityDate, StringFormat='Data: {0:dd.MM.yyyy}'}" Foreground="#D9A441"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
