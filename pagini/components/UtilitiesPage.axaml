<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="640"
             x:Class="BugalterProject.pagini.components.UtilitiesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Serviciile comunale" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Sectiunea permite evidenta platilor pentru apa, lumina, gaz si internet."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1.35*,.75*" ColumnSpacing="14">
                <StackPanel Spacing="14">
                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="16">
                            <TextBlock Text="In total de platit luna aceasta" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <Border Grid.Column="1" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <TextBlock Text="2026/05/07" Foreground="White"/>
                            </Border>

                            <TextBox Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     PlaceholderText="Introdu valoarea sau observatia principala"
                                     Padding="12"
                                     Background="#3A3A3A"
                                     Foreground="White"/>

                            <UniformGrid Grid.Row="2" Grid.ColumnSpan="2" Columns="2" Rows="2">
                                <Border Margin="0,0,12,12" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Apa" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="432 MDL" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,0,12" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Lumina" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="833 MDL" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,0,12,0" Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Gaz" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="656 MDL" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#3A3A3A" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Internet" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="260 MDL" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <TextBlock Text="Numara singur cat trebuie sa achiti" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Evolutia costurilor" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <Canvas Height="280" Background="#3A3A3A">
                            <Line StartPoint="24,220" EndPoint="72,170" Stroke="White" StrokeThickness="2"/>
                            <Line StartPoint="72,170" EndPoint="126,118" Stroke="White" StrokeThickness="2"/>
                            <Line StartPoint="126,118" EndPoint="178,160" Stroke="White" StrokeThickness="2"/>
                            <Line StartPoint="178,160" EndPoint="232,112" Stroke="White" StrokeThickness="2"/>
                            <Line StartPoint="232,112" EndPoint="302,56" Stroke="White" StrokeThickness="2"/>
                        </Canvas>
                        <TextBlock Text="Total estimat: 2 181 MDL" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
