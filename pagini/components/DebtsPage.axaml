<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.DebtsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#495569" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A3140" Offset="0"/>
                        <GradientStop Color="#1B2330" Offset="0.6"/>
                        <GradientStop Color="#141B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#40331E">
                        <TextBlock Text="Datorii" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Datoriile si responsabilitatile" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Aici gestionezi sumele pe care trebuie sa le achiti si pe cele pe care trebuie sa le recuperezi."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.95*,1.2*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Formular datorie" FontSize="24" FontWeight="Bold"/>

                        <Border x:Name="UserPickerBorder" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="UserCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Persoana sau institutia" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="PersonNameBox" PlaceholderText="Ex: Victoriabank sau Andrei"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Tip datorie" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="DebtTypeCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma curenta" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="AmountBox" PlaceholderText="Ex: 820.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma achitata acum" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="PaymentAmountBox" PlaceholderText="Ex: 50.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Scadenta" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="DueDatePicker"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Salveaza"
                                    Click="SaveDebt"
                                    Margin="0,0,10,10"
                                    Background="#C4943F"
                                    Foreground="#1E2330"/>
                            <Button Content="Aplica plata"
                                    Click="ApplyDebtPayment"
                                    Margin="0,0,10,10"
                                    Background="#486B4F"/>
                            <Button Content="Sterge"
                                    Click="DeleteDebt"
                                    Margin="0,0,10,10"
                                    Background="{StaticResource DangerBrush}"/>
                        </WrapPanel>

                        <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Lista datoriilor" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="DebtsCountText" Text="Datorii gasite: 0" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="6" Width="230">
                                    <TextBlock Text="Afisare" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox x:Name="DebtViewCombo" SelectionChanged="DebtViewCombo_SelectionChanged"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ListBox x:Name="DebtsList"
                                 Height="560"
                                 SelectionChanged="DebtsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:DebtItem">
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            Background="#283243"
                                            BorderBrush="#3C4960"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="{Binding PersonName}" FontWeight="Bold" FontSize="17"/>
                                                <Border Grid.Column="1" Background="#3A4962" CornerRadius="999" Padding="10,4">
                                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}" Foreground="#A8C8FF"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="{Binding DebtTypeLabel}" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#D9A441"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
