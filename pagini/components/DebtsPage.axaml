<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             x:Class="BugalterProject.pagini.components.DebtsPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">

            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Datoriile si responsabilitatile" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Aici pot fi adaugate, modificate si sterse datoriile personale si sumele de recuperat."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1.2*" ColumnSpacing="14">

                <Border Grid.Column="1"
                        Background="#2A2A2A"
                        BorderBrush="#505050"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Lista datoriilor" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="DebtsCountText" Text="Datorii gasite: 0" FontWeight="Bold" Foreground="White"/>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Afisare" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="DebtViewCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"
                                          SelectionChanged="DebtViewCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="DebtsList"
                                 Background="#252525"
                                 BorderBrush="#505050"
                                 BorderThickness="1"
                                 Foreground="White"
                                 Height="500"
                                 SelectionChanged="DebtsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:DebtItem">
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="#3A3A3A"
                                            BorderBrush="#505050"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding PersonName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="#CFCFCF"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding DebtTypeLabel}" Foreground="#CFCFCF"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}"
                                                           Foreground="#7DB4FF"
                                                           Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DueDate, StringFormat='{}{0:dd.MM.yyyy}'}"
                                                           Foreground="#CFCFCF"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0"
                        Background="#2A2A2A"
                        BorderBrush="#505050"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Formular datorie" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border x:Name="UserPickerBorder"
                                Background="#252525"
                                BorderBrush="#505050"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="UserCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Persoana / institutia" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="PersonNameBox"
                                         Background="#3A3A3A"
                                         Foreground="White"
                                         BorderBrush="#505050"
                                         PlaceholderText="Ex: Victoriabank sau Andrei"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Tip datorie" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="DebtTypeCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="AmountBox"
                                         Background="#3A3A3A"
                                         Foreground="White"
                                         BorderBrush="#505050"
                                         PlaceholderText="Ex: 820.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma pentru plata" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="PaymentAmountBox"
                                         Background="#3A3A3A"
                                         Foreground="White"
                                         BorderBrush="#505050"
                                         PlaceholderText="Ex: 50.00"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Scadenta" FontWeight="Bold" Foreground="White"/>
                                <DatePicker x:Name="DueDatePicker"
                                            Background="#3A3A3A"
                                            Foreground="White"
                                            BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Salveaza"
                                    Click="SaveDebt"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#3A3A3A"
                                    Foreground="White"/>

                            <Button Content="Aplica plata"
                                    Click="ApplyDebtPayment"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#355E3B"
                                    Foreground="White"/>

                            <Button Content="Sterge"
                                    Click="DeleteDebt"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#7A2E2E"
                                    Foreground="White"/>
                        </WrapPanel>

                        <TextBlock x:Name="SummaryText" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusText" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
