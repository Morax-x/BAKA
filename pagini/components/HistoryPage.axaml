<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.HistoryPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Istoricul operatiunilor" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Aici este afisata evolutia cheltuielilor, a datoriilor stinse si a platilor comunale achitate."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                <Border Grid.Column="0" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli luna aceasta" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="CurrentMonthTotalText" Text="0.00 MDL" FontSize="24" FontWeight="Bold" Foreground="#7DB4FF"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli luna trecuta" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="PreviousMonthTotalText" Text="0.00 MDL" FontSize="24" FontWeight="Bold" Foreground="#CFCFCF"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Datorii stinse" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SettledDebtsCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#9AD27D"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Plati comunale achitate" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="PaidUtilitiesCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F2C879"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="18">
                <TextBlock x:Name="DifferenceText"
                           Text="Se incarca sumarul..."
                           FontWeight="Bold"
                           Foreground="White"
                           TextWrapping="Wrap"/>
            </Border>

            <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="14">
                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Cheltuieli luna aceasta" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="CurrentMonthItemsText" Text="Se incarca datele..." Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Cheltuieli luna trecuta" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="PreviousMonthItemsText" Text="Se incarca datele..." Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="14">
                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Datorii stinse" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="SettledDebtsText" Text="Nu exista datorii stinse." Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Plati comunale achitate" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="PaidUtilitiesText" Text="Nu exista plati achitate." Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Export in Excel" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Exportul genereaza un fisier CSV compatibil cu Excel, cu toate datele din istoricul curent."
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                    <Button Content="Exporta istoricul"
                            Padding="18,10"
                            Background="#3A3A3A"
                            Foreground="White"
                            HorizontalAlignment="Left"
                            Click="ExportHistory"/>
                    <TextBlock x:Name="ExportStatusText" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="Golire istoric" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Aceasta actiune sterge cheltuielile din istoric si elimina doar datoriile deja stinse si platile comunale deja achitate. Elementele active raman in aplicatie."
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                    <CheckBox x:Name="ClearHistoryConfirmCheck"
                              Content="Confirm stergerea istoricului"
                              Foreground="White"/>
                    <Button Content="Goleste istoricul"
                            Padding="18,10"
                            Background="#7A2E2E"
                            Foreground="White"
                            HorizontalAlignment="Left"
                            Click="ClearHistory"/>
                    <TextBlock x:Name="ClearHistoryStatusText" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
