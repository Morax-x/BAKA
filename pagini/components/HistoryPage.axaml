<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="BugalterProject.pagini.components.HistoryPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#495569" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#243246" Offset="0"/>
                        <GradientStop Color="#1B2330" Offset="0.6"/>
                        <GradientStop Color="#141B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#40331E">
                        <TextBlock Text="Istoricul" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Istoricul operatiunilor" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Evolutia cheltuielilor, a datoriilor stinse si a platilor comunale achitate, intr-o pagina mai clara."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli luna aceasta" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="CurrentMonthTotalText" Text="0.00 MDL" FontSize="26" FontWeight="Bold" Foreground="#8FB9FF"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Cheltuieli luna trecuta" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PreviousMonthTotalText" Text="0.00 MDL" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Datorii stinse" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="SettledDebtsCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#88C59C"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Plati comunale achitate" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock x:Name="PaidUtilitiesCountText" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F0C36A"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#1A2030" BorderBrush="#37465C" BorderThickness="1" CornerRadius="18" Padding="18">
                <TextBlock x:Name="DifferenceText" Text="Se incarca sumarul..." FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>

            <Grid ColumnDefinitions="1.08*,0.92*" ColumnSpacing="16">
                <StackPanel Grid.Column="0" Spacing="16">
                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Cheltuieli luna aceasta" FontSize="24" FontWeight="Bold"/>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <TextBlock x:Name="CurrentMonthItemsText" Text="Se incarca datele..." TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Cheltuieli luna trecuta" FontSize="24" FontWeight="Bold"/>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <TextBlock x:Name="PreviousMonthItemsText" Text="Se incarca datele..." TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Datorii stinse" FontSize="24" FontWeight="Bold"/>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <TextBlock x:Name="SettledDebtsText" Text="Nu exista datorii stinse." TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Plati comunale achitate" FontSize="24" FontWeight="Bold"/>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="16">
                                <TextBlock x:Name="PaidUtilitiesText" Text="Nu exista plati achitate." TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Export in Excel" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Exportul genereaza un fisier CSV compatibil cu Excel, cu toate datele din istoricul curent."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <Button Content="Exporta istoricul"
                                HorizontalAlignment="Left"
                                Click="ExportHistory"
                                Background="#324055"/>
                        <TextBlock x:Name="ExportStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Golire istoric" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Sterge cheltuielile din istoric si elimina doar datoriile deja stinse si platile comunale deja achitate."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="ClearHistoryConfirmCheck" Content="Confirm stergerea istoricului"/>
                        <Button Content="Goleste istoricul"
                                HorizontalAlignment="Left"
                                Click="ClearHistory"
                                Background="{StaticResource DangerBrush}"/>
                        <TextBlock x:Name="ClearHistoryStatusText" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
