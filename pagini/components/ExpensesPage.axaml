<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="720"
             x:Class="BugalterProject.pagini.components.ExpensesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="14">
            <Border Background="#2A2A2A" BorderBrush="#505050" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="Gestionare cheltuieli" FontSize="28" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Aici pot fi adaugate, modificate si sterse cheltuielile principale ale aplicatiei."
                               FontSize="14"
                               Foreground="#CFCFCF"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="1*,1.3*" ColumnSpacing="14">
                <Border Grid.Column="1"
                        Background="#2A2A2A"
                        BorderBrush="#505050"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Lista cheltuielilor" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="ExpensesCountText"
                                   Text="Cheltuieli gasite: 0"
                                   FontWeight="Bold"
                                   Foreground="White"/>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Afisare" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="ExpenseViewCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"
                                          SelectionChanged="ExpenseViewCombo_SelectionChanged"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="ExpensesList"
                                 Background="#252525"
                                 BorderBrush="#505050"
                                 BorderThickness="1"
                                 Foreground="White"
                                 Height="500"
                                 SelectionChanged="ExpensesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ExpenseItem">
                                    <Border Margin="0,0,0,8"
                                            Padding="12"
                                            Background="#3A3A3A"
                                            BorderBrush="#505050"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="#CFCFCF"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#CFCFCF" TextWrapping="Wrap"/>
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="{Binding ExpenseDate, StringFormat='{}{0:dd.MM.yyyy}'}" Foreground="#CFCFCF"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}" Foreground="#7DB4FF" Margin="12,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding ExpenseId, StringFormat='ID: {0}'}" Foreground="#CFCFCF" Margin="12,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="0"
                        Background="#2A2A2A"
                        BorderBrush="#505050"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Formular cheltuiala" FontSize="22" FontWeight="Bold" Foreground="White"/>

                        <Border x:Name="UserPickerBorder" Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="UserCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Categorie" FontWeight="Bold" Foreground="White"/>
                                <ComboBox x:Name="CategoryCombo"
                                          Background="#3A3A3A"
                                          Foreground="White"
                                          BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="AmountBox"
                                         Background="#3A3A3A"
                                         Foreground="White"
                                         BorderBrush="#505050"
                                         PlaceholderText="Ex: 150.50"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Descriere" FontWeight="Bold" Foreground="White"/>
                                <TextBox x:Name="DescriptionBox"
                                         Background="#3A3A3A"
                                         Foreground="White"
                                         BorderBrush="#505050"
                                         PlaceholderText="Detalii optionale"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="80"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252525" BorderBrush="#505050" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Data" FontWeight="Bold" Foreground="White"/>
                                <DatePicker x:Name="ExpenseDatePicker"
                                            Background="#3A3A3A"
                                            Foreground="White"
                                            BorderBrush="#505050"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Salveaza"
                                    Click="SaveExpense"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#3A3A3A"
                                    Foreground="White"/>
                            <Button Content="Cheltuiala noua"
                                    Click="ClearForm"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#3A3A3A"
                                    Foreground="White"/>
                            <Button Content="Sterge"
                                    Click="DeleteExpense"
                                    Padding="16,10"
                                    Margin="0,0,10,10"
                                    Background="#7A2E2E"
                                    Foreground="White"/>
                        </WrapPanel>

                        <TextBlock x:Name="StatusText"
                                   Foreground="#CFCFCF"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
