<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:data="using:BugalterProject.Data"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             x:Class="BugalterProject.pagini.components.ExpensesPage">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,0,14,14" Spacing="16">
            <Border CornerRadius="22" BorderBrush="#495569" BorderThickness="1" Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#253041" Offset="0"/>
                        <GradientStop Color="#1B2330" Offset="0.6"/>
                        <GradientStop Color="#141B25" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Spacing="8">
                    <Border HorizontalAlignment="Left" Padding="10,4" CornerRadius="999" Background="#40331E">
                        <TextBlock Text="Cheltuieli" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                    <TextBlock Text="Gestionare cheltuieli" FontSize="30" FontWeight="Bold"/>
                    <TextBlock Text="Adauga, editeaza si urmareste toate cheltuielile intr-o forma mai clara si mai usor de parcurs."
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="0.95*,1.25*" ColumnSpacing="16">
                <Border Grid.Column="0" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Formular cheltuiala" FontSize="24" FontWeight="Bold"/>

                        <Border x:Name="UserPickerBorder" Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Utilizator" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="UserCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Categorie" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <ComboBox x:Name="CategoryCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Suma" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="AmountBox" PlaceholderText="Ex: 150.50"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Descriere" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox x:Name="DescriptionBox"
                                         PlaceholderText="Detalii optionale"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="110"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Data" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                <DatePicker x:Name="ExpenseDatePicker"/>
                            </StackPanel>
                        </Border>

                        <WrapPanel>
                            <Button Content="Salveaza"
                                    Click="SaveExpense"
                                    Margin="0,0,10,10"
                                    Background="#C4943F"
                                    Foreground="#1E2330"/>
                            <Button Content="Cheltuiala noua"
                                    Click="ClearForm"
                                    Margin="0,0,10,10"
                                    Background="#324055"/>
                            <Button Content="Sterge"
                                    Click="DeleteExpense"
                                    Margin="0,0,10,10"
                                    Background="{StaticResource DangerBrush}"/>
                        </WrapPanel>

                        <Border Background="#161D28" BorderBrush="#364255" BorderThickness="1" CornerRadius="14" Padding="14">
                            <TextBlock x:Name="StatusText"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#1D2431" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="22">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel>
                                <TextBlock Text="Lista cheltuielilor" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="ExpensesCountText"
                                           Text="Cheltuieli gasite: 0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Background="#283243" BorderBrush="#3C4960" BorderThickness="1" CornerRadius="14" Padding="12">
                                <StackPanel Spacing="6" Width="230">
                                    <TextBlock Text="Afisare" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <ComboBox x:Name="ExpenseViewCombo"
                                              SelectionChanged="ExpenseViewCombo_SelectionChanged"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ListBox x:Name="ExpensesList"
                                 Height="560"
                                 SelectionChanged="ExpensesList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="data:ExpenseItem">
                                    <Border Margin="0,0,0,10"
                                            Padding="14"
                                            Background="#283243"
                                            BorderBrush="#3C4960"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <TextBlock Text="{Binding CategoryName}" FontWeight="Bold" FontSize="17"/>
                                                <Border Grid.Column="1" Background="#3A4962" CornerRadius="999" Padding="10,4">
                                                    <TextBlock Text="{Binding Amount, StringFormat='{}{0:0.00} MDL'}" Foreground="#A8C8FF"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding OwnerName}" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ExpenseDate, StringFormat='Data: {0:dd.MM.yyyy}'}" Foreground="#D9A441"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
