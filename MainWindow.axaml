<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="using:BugalterProject.pagini.components"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="820"
        Width="1280"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        x:Class="BugalterProject.MainWindow"
        Title="Bani Asistent si Kontrol Activetati (BAKA)">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11161F" Offset="0"/>
            <GradientStop Color="#1A2230" Offset="0.45"/>
            <GradientStop Color="#121A24" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid RowDefinitions="Auto,*,Auto">
        <components:Navbar x:Name="TopNavbar" Grid.Row="0"/>
        <ContentControl x:Name="MainContent" Grid.Row="1"/>

        <Border Grid.Row="2"
                Margin="14,0,14,14"
                Padding="14,12"
                Background="#1A2030"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Border Width="12"
                        Height="12"
                        CornerRadius="999"
                        Background="{StaticResource AccentBrush}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Center"
                           Text="BAKA organizeaza cheltuielile, datoriile si serviciile comunale intr-un singur spatiu clar."
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="2"
                           Text="© 2026 BAKA"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
